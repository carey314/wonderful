# Wonderful 环境配置
# 复制此文件为 .env 并填入真实配置

# ============================================
# 调试模式（生产环境设为 false）
# ============================================
DEBUG=true

# ============================================
# AI 引擎 API Key
# ============================================
# DeepSeek（主力模型，https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 智谱 GLM-4-Flash（免费备用，https://bigmodel.cn）
GLM_API_KEY=your-glm-api-key

# 默认 AI 引擎: deepseek 或 glm
AI_DEFAULT_ENGINE=deepseek

# ============================================
# JWT 认证密钥（生产环境必须修改！）
# ============================================
JWT_SECRET_KEY=your-random-secret-key-change-this

# ============================================
# 微信小程序（https://mp.weixin.qq.com）
# ============================================
WX_APP_ID=your-wechat-app-id
WX_APP_SECRET=your-wechat-app-secret
