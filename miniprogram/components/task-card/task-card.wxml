<!-- 任务卡片组件 - V2 玻璃拟态版 -->
<view class="task-card {{completed ? 'completed' : ''}} {{overdue ? 'overdue' : ''}}" bindtap="onTap">
  <!-- 项目颜色标签 - 左侧色条 -->
  <view class="project-stripe" wx:if="{{projectInfo}}" style="background: {{projectInfo.color}}"></view>

  <view class="card-body {{projectInfo ? 'has-stripe' : ''}}">
    <!-- 顶部：优先级 + 项目标签 + 金币奖励 -->
    <view class="card-header">
      <view class="priority-dot" style="background: {{priorityColor}}"></view>
      <text class="priority-label" style="color: {{priorityColor}}">{{priorityLabel}}</text>
      <view class="project-tag" wx:if="{{projectInfo}}" style="background: {{projectInfo.color}}20; color: {{projectInfo.color}}">
        <text>{{projectInfo.icon}} {{projectInfo.label}}</text>
      </view>
      <view class="spacer"></view>
      <view class="coin-chip">
        <text class="coin-text">+{{task.coinReward}}</text>
        <text class="coin-spark">✨</text>
      </view>
    </view>

    <!-- 标题 -->
    <text class="task-title {{completed ? 'done' : ''}}">{{task.title}}</text>
    <text class="task-desc" wx:if="{{task.description}}">{{task.description}}</text>

    <!-- 进度条 - 有子任务时根据完成情况显示 -->
    <view class="progress-row" wx:if="{{hasSubtasks && !completed}}">
      <view class="progress-track">
        <view class="progress-bar" style="width: {{progress}}%">
          <view class="progress-glow"></view>
        </view>
      </view>
      <text class="progress-pct">{{subtaskCountText}}</text>
    </view>

    <!-- 子任务展开/折叠区域 -->
    <view class="subtask-toggle" wx:if="{{hasSubtasks}}" catchtap="toggleExpand">
      <text class="subtask-toggle-icon {{expanded ? 'expanded' : ''}}">▸</text>
      <text class="subtask-toggle-text">子任务 {{subtaskCountText}}</text>
    </view>

    <view class="subtask-list {{expanded ? 'show' : ''}}">
      <view
        class="subtask-item {{item.completed ? 'subtask-done' : ''}}"
        wx:for="{{task.subtasks}}"
        wx:key="id"
        catchtap="onToggleSubtask"
        data-id="{{item.id}}"
      >
        <view class="subtask-checkbox {{item.completed ? 'checked' : ''}}">
          <view class="subtask-check-icon" wx:if="{{item.completed}}">✓</view>
        </view>
        <text class="subtask-title {{item.completed ? 'subtask-title-done' : ''}}">{{item.title}}</text>
        <text class="subtask-time" wx:if="{{item.estimatedMinutes > 0}}">{{item.estimatedMinutes}}min</text>
      </view>
    </view>

    <!-- 底部标签 -->
    <view class="tag-row">
      <view class="info-tag time-tag" wx:if="{{estimatedTimeText}}">
        <text>⏱ {{estimatedTimeText}}</text>
      </view>
      <view class="info-tag energy" wx:if="{{task.energy}}" style="color: {{energyColor}}">
        <text>{{energyLabel}}</text>
      </view>
      <view class="info-tag streak" wx:if="{{task.streakDays > 0}}">
        <text>🔥 {{task.streakDays}}天</text>
      </view>
      <view class="spacer"></view>
      <view class="info-tag due {{overdue ? 'due-overdue' : ''}}" wx:if="{{deadlineText}}">
        <text>📅 {{deadlineText}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-row" wx:if="{{!completed}}">
      <button class="btn-done" catchtap="onComplete">完成 ✓</button>
      <button class="btn-skip" catchtap="onSkip">换个角度看</button>
    </view>

    <!-- 完成状态 -->
    <view class="done-badge" wx:if="{{completed}}">
      <text>✅ 已完成</text>
    </view>
  </view>

  <!-- 装饰性渐变圆 -->
  <view class="deco-circle" style="background: {{priorityColor}}"></view>
</view>
