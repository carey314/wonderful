<!-- 任务卡片 - V3 子任务直接可见 + 紧凑操作 -->
<view class="task-card {{completed ? 'completed' : ''}} {{overdue ? 'overdue' : ''}}" bindtap="onTap">
  <!-- 项目颜色标签 -->
  <view class="project-stripe" wx:if="{{projectInfo}}" style="background: {{projectInfo.color}}"></view>

  <view class="card-body {{projectInfo ? 'has-stripe' : ''}}">
    <!-- 头部 -->
    <view class="card-header">
      <view class="priority-dot" style="background: {{priorityColor}}"></view>
      <text class="priority-label" style="color: {{priorityColor}}">{{priorityLabel}}</text>
      <view class="project-tag" wx:if="{{projectInfo}}" style="background: {{projectInfo.color}}20; color: {{projectInfo.color}}">
        <text>{{projectInfo.icon}} {{projectInfo.label}}</text>
      </view>
      <view class="spacer"></view>
      <view class="coin-chip">
        <text class="coin-text">+{{task.coinReward}}</text>
        <text class="coin-spark">✨</text>
      </view>
    </view>

    <!-- 标题 -->
    <text class="task-title {{completed ? 'done' : ''}}">{{task.title}}</text>

    <!-- 子任务直接可见（前3个） -->
    <view class="subtask-face" wx:if="{{hasSubtasks && !completed}}">
      <view class="subtask-face-bar">
        <view class="subtask-face-track">
          <view class="subtask-face-fill" style="width: {{progress}}%"></view>
        </view>
        <text class="subtask-face-count">{{subtaskCountText}}</text>
      </view>
      <view
        class="subtask-face-item {{item.completed ? 'face-done' : ''}}"
        wx:for="{{showAllSubtasks ? task.subtasks : visibleSubtasks}}"
        wx:key="id"
        catchtap="onToggleSubtask"
        data-id="{{item.id}}"
      >
        <view class="face-check {{item.completed ? 'checked' : ''}}">
          <text wx:if="{{item.completed}}" class="face-check-icon">✓</text>
        </view>
        <text class="face-title {{item.completed ? 'face-title-done' : ''}}">{{item.title}}</text>
      </view>
      <view class="subtask-more" wx:if="{{extraSubtaskCount > 0}}" catchtap="toggleShowAll">
        <text>{{showAllSubtasks ? '收起' : '还有 ' + extraSubtaskCount + ' 项...'}}</text>
      </view>
    </view>

    <!-- 底部：标签 + 操作按钮 -->
    <view class="card-footer" wx:if="{{!completed}}">
      <view class="tag-row">
        <view class="info-tag" wx:if="{{estimatedTimeText}}">⏱ {{estimatedTimeText}}</view>
        <view class="info-tag" wx:if="{{task.energy}}" style="color: {{energyColor}}">{{energyLabel}}</view>
        <view class="info-tag due {{overdue ? 'due-overdue' : ''}}" wx:if="{{deadlineText}}">📅 {{deadlineText}}</view>
      </view>
      <view class="action-btns">
        <view class="act-btn act-postpone" catchtap="onPostpone">改天</view>
        <view class="act-btn act-complete" catchtap="onComplete">完成</view>
      </view>
    </view>

    <!-- 完成状态 -->
    <view class="card-footer" wx:if="{{completed}}">
      <view class="tag-row">
        <view class="info-tag" wx:if="{{estimatedTimeText}}">⏱ {{estimatedTimeText}}</view>
      </view>
      <text class="done-badge">✅ 已完成</text>
    </view>
  </view>

  <view class="deco-circle" style="background: {{priorityColor}}"></view>
</view>
