/* 任务卡片 - V3 子任务直接可见 + 紧凑操作 */

.task-card {
  position: relative;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 28rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.task-card:active { transform: scale(0.97); }
.task-card.completed { opacity: 0.55; }
.task-card.overdue { border-color: rgba(255, 107, 107, 0.3); }

.project-stripe {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 8rpx;
  border-radius: 28rpx 0 0 28rpx;
  z-index: 2;
}

.deco-circle {
  position: absolute;
  top: -40rpx; right: -40rpx;
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  opacity: 0.07;
  pointer-events: none;
}

.card-body {
  position: relative;
  padding: 24rpx 28rpx;
  z-index: 1;
}

.card-body.has-stripe { padding-left: 36rpx; }

/* ====== 头部 ====== */
.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.priority-dot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  box-shadow: 0 0 10rpx currentColor;
}

.priority-label {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.project-tag {
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
}

.spacer { flex: 1; }

.coin-chip {
  display: flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, rgba(251,191,36,0.12), rgba(255,107,157,0.08));
}

.coin-text {
  font-size: 22rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #D97706, #FBBF24);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.coin-spark { font-size: 16rpx; margin-left: 4rpx; }

/* ====== 标题 ====== */
.task-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1E1B4B;
  line-height: 1.4;
  letter-spacing: -0.5rpx;
}

.title-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.title-row .task-title {
  flex: 1;
}

.task-title.done {
  text-decoration: line-through;
  color: #A5A5C0;
}

.postpone-badge {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 107, 107, 0.12);
  margin-top: 4rpx;
}

.postpone-badge text {
  font-size: 20rpx;
  color: #FF6B6B;
  font-weight: 600;
}

/* ====== 子任务直接可见 ====== */
.subtask-face {
  margin-top: 14rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(124, 92, 252, 0.04);
}

.subtask-face-bar {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.subtask-face-track {
  flex: 1;
  height: 8rpx;
  background: rgba(124, 92, 252, 0.06);
  border-radius: 4rpx;
  overflow: hidden;
}

.subtask-face-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #7C5CFC, #A78BFA, #EC4899);
  transition: width 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.subtask-face-count {
  font-size: 22rpx;
  font-weight: 600;
  color: #7C5CFC;
  margin-left: 12rpx;
}

.subtask-face-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.subtask-face-item.face-done { opacity: 0.45; }

.face-check {
  width: 30rpx; height: 30rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(124, 92, 252, 0.25);
  margin-right: 12rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}

.face-check.checked {
  background: linear-gradient(135deg, #7C5CFC, #A78BFA);
  border-color: transparent;
}

.face-check-icon {
  font-size: 16rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.face-title {
  font-size: 25rpx;
  color: #374151;
  line-height: 1.3;
}

.face-title-done {
  text-decoration: line-through;
  color: #A5A5C0;
}

.subtask-more {
  padding: 6rpx 0;
  text-align: center;
}

.subtask-more text {
  font-size: 22rpx;
  color: #7C5CFC;
  font-weight: 500;
}

/* ====== 底部：标签 + 按钮 ====== */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(124, 92, 252, 0.04);
}

.tag-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.info-tag {
  font-size: 21rpx;
  color: #6B7280;
  padding: 3rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(124, 92, 252, 0.04);
  white-space: nowrap;
}

.info-tag.due { color: #A5A5C0; background: transparent; }
.info-tag.due-overdue { color: #FF6B6B; font-weight: 600; background: rgba(255,107,107,0.08); }

/* 紧凑操作按钮 */
.action-btns {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.act-btn {
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.act-btn:active { transform: scale(0.92); }

.act-complete {
  background: linear-gradient(135deg, #7C5CFC, #A78BFA);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(124, 92, 252, 0.25);
}

.act-postpone {
  background: rgba(148, 163, 184, 0.1);
  color: #94A3B8;
}

/* ====== 完成徽章 ====== */
.done-badge {
  font-size: 22rpx;
  color: #06D6A0;
  font-weight: 500;
  flex-shrink: 0;
}
