/* 任务卡片列表页 - V2 */
.tasks-page {
  padding-bottom: 40rpx;
}

/* 视图切换 - 毛玻璃胶囊 */
.view-toggle {
  display: flex;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  border-radius: var(--radius-2xl);
  padding: 6rpx;
  margin-bottom: var(--spacing-md);
}

.toggle-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--radius-xl);
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.toggle-item.active {
  background: var(--gradient-primary);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(124, 92, 252, 0.25);
}

/* 项目筛选 - 与首页一致 */
.filter-scroll {
  white-space: nowrap;
  margin-bottom: var(--spacing-lg);
}

.filter-inner {
  display: inline-flex;
  gap: var(--spacing-sm);
  padding: 4rpx 0;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-2xl);
  font-size: 22rpx;
  font-weight: 600;
  background: var(--glass-bg);
  border: 1rpx solid rgba(124, 92, 252, 0.08);
  transition: all 0.25s ease;
}

.filter-chip.active {
  box-shadow: 0 4rpx 16rpx rgba(124, 92, 252, 0.2);
}

.filter-count {
  font-size: 20rpx;
  opacity: 0.7;
}

/* 任务分组 */
.task-group {
  margin-bottom: var(--spacing-xl);
}

.group-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--spacing-md);
  padding-left: 8rpx;
  letter-spacing: 1rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-2xl) 0;
}

.empty-emoji { font-size: 64rpx; margin-bottom: var(--spacing-md); }

.empty-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--spacing-xs);
}

.empty-hint {
  font-size: 24rpx;
  color: var(--color-text-light);
}

/* 四象限 - 玻璃卡片 */
.quadrant-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-md);
}

.quadrant-cell {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  min-height: 280rpx;
  position: relative;
  overflow: hidden;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.quadrant-cell:active {
  transform: scale(0.97);
}

/* 四象限顶部颜色条 */
.quadrant-cell.urgent-important { border-top: 6rpx solid #FF6B6B; }
.quadrant-cell.important { border-top: 6rpx solid #7C5CFC; }
.quadrant-cell.urgent { border-top: 6rpx solid #FF6B9D; }
.quadrant-cell.normal { border-top: 6rpx solid #06D6A0; }

.quadrant-label {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.quadrant-hint {
  font-size: 20rpx;
  color: var(--color-text-light);
  margin-bottom: var(--spacing-sm);
}

.quadrant-task {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(124, 92, 252, 0.06);
}

.quadrant-task:last-child { border-bottom: none; }

.quadrant-task-title {
  font-size: 24rpx;
  color: var(--color-text);
  font-weight: 500;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quadrant-task-coin {
  font-size: 22rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #D97706, #FBBF24);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-left: 8rpx;
}

.quadrant-empty {
  padding: 20rpx 0;
}

.quadrant-empty-text {
  font-size: 22rpx;
  color: var(--color-text-light);
}
