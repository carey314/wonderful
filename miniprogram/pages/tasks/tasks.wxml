<!-- 任务卡片列表页 - V2 -->
<view class="container tasks-page">

  <!-- 视图切换：列表 / 四象限 -->
  <view class="view-toggle">
    <view
      class="toggle-item {{viewMode === 'list' ? 'active' : ''}}"
      bindtap="switchView"
      data-mode="list"
    >
      列表
    </view>
    <view
      class="toggle-item {{viewMode === 'quadrant' ? 'active' : ''}}"
      bindtap="switchView"
      data-mode="quadrant"
    >
      四象限
    </view>
  </view>

  <!-- 项目筛选标签 -->
  <scroll-view class="filter-scroll" scroll-x>
    <view class="filter-inner">
      <view
        class="filter-chip {{activeFilter === item.key ? 'active' : ''}}"
        wx:for="{{projectFilters}}"
        wx:key="key"
        bindtap="onFilterTap"
        data-key="{{item.key}}"
        style="{{activeFilter === item.key ? 'background:' + item.color + '; color: #fff;' : 'color:' + item.color + ';'}}"
      >
        <text>{{item.icon}} {{item.label}}</text>
        <text class="filter-count">{{item.count}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 列表视图 -->
  <view wx:if="{{viewMode === 'list'}}" class="task-list">
    <!-- 进行中 -->
    <view class="task-group" wx:if="{{filteredPending.length > 0}}">
      <view class="group-title">进行中 ({{filteredPending.length}})</view>
      <task-card
        wx:for="{{filteredPending}}"
        wx:key="id"
        task="{{item}}"
        mode="detail"
        bind:complete="onTaskComplete"
        bind:skip="onTaskSkip"
        bind:tap="onTaskDetail"
        bind:subtaskToggle="onSubtaskToggle"
      />
    </view>

    <!-- 已完成 -->
    <view class="task-group" wx:if="{{filteredCompleted.length > 0}}">
      <view class="group-title text-secondary">已完成 ({{filteredCompleted.length}})</view>
      <task-card
        wx:for="{{filteredCompleted}}"
        wx:key="id"
        task="{{item}}"
        mode="detail"
        completed="{{true}}"
      />
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{filteredPending.length === 0 && filteredCompleted.length === 0}}">
      <text class="empty-emoji">📋</text>
      <text class="empty-text">还没有任务卡片</text>
      <text class="empty-hint">点下面的按钮创建第一个目标</text>
    </view>
  </view>

  <!-- 四象限视图 -->
  <view wx:if="{{viewMode === 'quadrant'}}" class="quadrant-view">
    <view class="quadrant-grid">
      <!-- 紧急且重要 -->
      <view class="quadrant-cell urgent-important">
        <view class="quadrant-label">🚨 紧急重要</view>
        <view class="quadrant-hint">赶紧做</view>
        <view
          wx:for="{{quadrantTasks.urgentImportant}}"
          wx:key="id"
          class="quadrant-task"
          bindtap="onTaskDetail"
          data-id="{{item.id}}"
        >
          <text class="quadrant-task-title">{{item.title}}</text>
          <text class="quadrant-task-coin">+{{item.coinReward}}</text>
        </view>
        <view class="quadrant-empty" wx:if="{{quadrantTasks.urgentImportant.length === 0}}">
          <text class="quadrant-empty-text">暂无</text>
        </view>
      </view>

      <!-- 重要不紧急 -->
      <view class="quadrant-cell important">
        <view class="quadrant-label">🎯 重要</view>
        <view class="quadrant-hint">优先做</view>
        <view
          wx:for="{{quadrantTasks.important}}"
          wx:key="id"
          class="quadrant-task"
          bindtap="onTaskDetail"
          data-id="{{item.id}}"
        >
          <text class="quadrant-task-title">{{item.title}}</text>
          <text class="quadrant-task-coin">+{{item.coinReward}}</text>
        </view>
        <view class="quadrant-empty" wx:if="{{quadrantTasks.important.length === 0}}">
          <text class="quadrant-empty-text">暂无</text>
        </view>
      </view>

      <!-- 紧急不重要 -->
      <view class="quadrant-cell urgent">
        <view class="quadrant-label">⚡ 紧急</view>
        <view class="quadrant-hint">快速处理</view>
        <view
          wx:for="{{quadrantTasks.urgent}}"
          wx:key="id"
          class="quadrant-task"
          bindtap="onTaskDetail"
          data-id="{{item.id}}"
        >
          <text class="quadrant-task-title">{{item.title}}</text>
          <text class="quadrant-task-coin">+{{item.coinReward}}</text>
        </view>
        <view class="quadrant-empty" wx:if="{{quadrantTasks.urgent.length === 0}}">
          <text class="quadrant-empty-text">暂无</text>
        </view>
      </view>

      <!-- 不紧急不重要 -->
      <view class="quadrant-cell normal">
        <view class="quadrant-label">🌱 种子</view>
        <view class="quadrant-hint">每天浇一点</view>
        <view
          wx:for="{{quadrantTasks.normal}}"
          wx:key="id"
          class="quadrant-task"
          bindtap="onTaskDetail"
          data-id="{{item.id}}"
        >
          <text class="quadrant-task-title">{{item.title}}</text>
          <text class="quadrant-task-coin">+{{item.coinReward}}</text>
        </view>
        <view class="quadrant-empty" wx:if="{{quadrantTasks.normal.length === 0}}">
          <text class="quadrant-empty-text">暂无</text>
        </view>
      </view>
    </view>
  </view>

</view>
