/* 搭子模式 - 匿名互助打卡 */

/* 头部介绍 */
.intro-section {
  text-align: center;
  padding: var(--spacing-xl) 0 var(--spacing-lg);
}

.intro-emoji {
  font-size: 100rpx;
  margin-bottom: var(--spacing-md);
  display: block;
}

.intro-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  background: var(--gradient-sunset);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: var(--spacing-sm);
}

.intro-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* 目标类型选择 */
.goal-section {
  margin-bottom: var(--spacing-lg);
}

.section-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-md);
}

.goal-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-md);
}

.goal-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-lg) var(--spacing-sm);
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 2rpx solid transparent;
  border-radius: var(--radius-lg);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.goal-chip.selected {
  border-color: var(--color-primary);
  background: rgba(124, 92, 252, 0.08);
  box-shadow: var(--shadow-glow);
  transform: scale(1.04);
}

.goal-chip:active {
  transform: scale(0.96);
}

.goal-chip-icon {
  font-size: 48rpx;
  margin-bottom: var(--spacing-xs);
}

.goal-chip-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
}

.goal-chip.selected .goal-chip-label {
  color: var(--color-primary);
}

/* 匹配按钮 */
.match-section {
  padding: var(--spacing-md) 0;
  text-align: center;
}

.match-btn {
  width: 80% !important;
  font-size: 32rpx !important;
  padding: 28rpx 0 !important;
}

.match-btn.matching {
  animation: pulse-soft 1.5s ease-in-out infinite;
}

/* 规则卡片 */
.rules-card {
  margin-top: var(--spacing-md);
}

.rules-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--spacing-md);
}

.rule-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) 0;
}

.rule-icon {
  font-size: 32rpx;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.rule-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* ======================== */
/* 已匹配 - 双人打卡面板   */
/* ======================== */

/* 鼓励横幅 */
.encourage-banner {
  text-align: center;
  padding: var(--spacing-lg) 0 var(--spacing-md);
}

.encourage-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary);
}

/* 双人面板 */
.duo-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-xl) !important;
  position: relative;
  overflow: hidden;
}

/* 面板光效装饰 */
.duo-panel::before {
  content: '';
  position: absolute;
  top: -80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124, 92, 252, 0.06), transparent 70%);
  pointer-events: none;
}

.duo-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.duo-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--glass-bg);
  border: 4rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.duo-avatar-wrap.done {
  border-color: var(--color-accent);
  box-shadow: 0 0 24rpx rgba(6, 214, 160, 0.3);
}

.duo-avatar {
  font-size: 56rpx;
}

.done-check {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-accent);
  color: white;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: bounce-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.duo-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-top: var(--spacing-sm);
}

.duo-streak {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

/* 中间 VS 区域 */
.duo-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 var(--spacing-md);
}

.duo-vs {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--glass-bg);
  border: var(--glass-border);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-sm);
  transition: all 0.5s ease;
}

.duo-vs.both-done {
  background: var(--gradient-cool);
  border: none;
  box-shadow: 0 0 30rpx rgba(6, 214, 160, 0.3);
  animation: bounce-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.vs-text {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--color-text-secondary);
}

.duo-vs.both-done .vs-text {
  font-size: 32rpx;
  color: white;
}

.bonus-badge {
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.15), rgba(255, 107, 157, 0.1));
  border-radius: var(--radius-xl);
  padding: 6rpx 16rpx;
  margin-bottom: var(--spacing-xs);
  animation: bounce-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s both;
}

.bonus-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #D97706;
}

.duo-goal-tag {
  margin-top: var(--spacing-xs);
}

/* 打卡按钮 */
.checkin-section {
  text-align: center;
  padding: var(--spacing-md) 0;
}

.checkin-btn {
  width: 80% !important;
  font-size: 32rpx !important;
  padding: 28rpx 0 !important;
}

.checkin-btn.done {
  background: var(--glass-bg) !important;
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  color: var(--color-accent) !important;
  border: 2rpx solid rgba(6, 214, 160, 0.3) !important;
  border-radius: var(--radius-2xl);
  box-shadow: none !important;
}

.checkin-btn.done::after {
  border: none;
}

/* 状态详情卡片 */
.status-card {
  padding: var(--spacing-md) var(--spacing-lg) !important;
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.status-row:last-child {
  border-bottom: none;
}

.status-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.status-value {
  font-size: 26rpx;
  font-weight: 600;
}

/* 更换搭子 */
.change-section {
  text-align: center;
  padding: var(--spacing-xl) 0;
}

.change-link {
  font-size: 26rpx;
  color: var(--color-text-light);
  text-decoration: underline;
}
