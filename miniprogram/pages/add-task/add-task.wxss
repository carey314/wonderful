/* 新建任务页面 - 年轻化版 */
.add-task-page {
  padding-bottom: 160rpx;
}

.form-section {
  margin-bottom: var(--spacing-xl);
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--spacing-md);
  letter-spacing: 0.5rpx;
}

.form-input {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  border-radius: var(--radius-xl);
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  transition: all 0.2s ease;
}

.form-input:focus {
  border-color: rgba(124, 92, 252, 0.3);
  box-shadow: 0 0 0 4rpx rgba(124, 92, 252, 0.08);
}

/* 选项组 - 胶囊按钮 */
.time-options,
.date-options,
.category-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.time-option,
.date-option,
.category-option {
  padding: 18rpx 36rpx;
  border-radius: var(--radius-2xl);
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  color: var(--color-text-secondary);
  font-size: 26rpx;
  font-weight: 500;
  border: 2rpx solid rgba(124, 92, 252, 0.08);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.time-option:active,
.date-option:active,
.category-option:active {
  transform: scale(0.95);
}

.time-option.active,
.date-option.active,
.category-option.active {
  background: rgba(124, 92, 252, 0.12);
  color: var(--color-primary);
  border-color: rgba(124, 92, 252, 0.25);
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(124, 92, 252, 0.12);
}

/* AI 预览 - 渐变边框 */
.ai-preview {
  margin-top: var(--spacing-lg);
  background: linear-gradient(135deg, rgba(124,92,252,0.04), rgba(255,107,157,0.04)) !important;
  border: 2rpx solid rgba(124, 92, 252, 0.15) !important;
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  position: relative;
  overflow: hidden;
  animation: scale-in 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.ai-preview::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(124,92,252,0.06), rgba(255,107,157,0.04));
  pointer-events: none;
}

.ai-preview-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-sm);
  position: relative;
}

.ai-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: var(--gradient-primary);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--spacing-sm);
}

.ai-label {
  font-size: 26rpx;
  font-weight: 600;
  background: var(--gradient-sunset);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.ai-preview-text {
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.8;
  position: relative;
}

/* 提交按钮 - 毛玻璃底栏 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-lg);
  padding-bottom: calc(var(--spacing-lg) + env(safe-area-inset-bottom));
  background: rgba(245, 243, 255, 0.85);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-top: 1rpx solid rgba(124, 92, 252, 0.06);
}

.submit-btn {
  width: 100%;
  font-size: 32rpx;
  padding: 28rpx 0;
}

.submit-btn[disabled] {
  background: rgba(124, 92, 252, 0.12) !important;
  color: var(--color-text-light) !important;
  box-shadow: none !important;
}

@keyframes scale-in {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}
