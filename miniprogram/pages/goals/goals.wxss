/* Goals Page */
.goals-page {
  min-height: 100vh;
  padding: 24rpx 32rpx;
  padding-bottom: 200rpx;
}

.page-header { margin-bottom: 24rpx; }

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: -1rpx;
}

/* Tab Bar */
.tab-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  border-radius: var(--radius-xl);
  transition: all 0.3s ease;
}

.tab-item.active {
  background: var(--gradient-primary);
  border-color: transparent;
}

.tab-icon { font-size: 28rpx; }
.tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}
.tab-item.active .tab-text { color: #FFFFFF; }

.tab-count {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: rgba(124, 92, 252, 0.1);
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}
.tab-item.active .tab-count {
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.2);
}

/* Vision Card */
.vision-card {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.vision-card:active { transform: scale(0.98); }

.vision-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.vision-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  flex: 1;
}

.vision-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 20rpx;
  line-height: 1.6;
}

/* Progress */
.vision-progress { margin-bottom: 20rpx; }

.progress-track {
  height: 14rpx;
  background: rgba(124, 92, 252, 0.06);
  border-radius: 7rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-bar {
  height: 100%;
  border-radius: 7rpx;
  background: linear-gradient(90deg, #7C5CFC, #A78BFA, #EC4899);
  position: relative;
  transition: width 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  min-width: 2%;
}

.progress-glow {
  position: absolute;
  right: 0; top: -3rpx; bottom: -3rpx;
  width: 24rpx;
  background: radial-gradient(circle, rgba(167,139,250,0.6), transparent);
  border-radius: 50%;
}

.progress-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* Children preview */
.vision-children {
  background: rgba(124, 92, 252, 0.03);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.child-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.child-status { font-size: 22rpx; margin-right: 10rpx; }

.child-title {
  font-size: 26rpx;
  color: var(--color-text);
}

.child-title.done {
  text-decoration: line-through;
  color: var(--color-text-light);
}

.vision-meta { display: flex; gap: 16rpx; }

.meta-label {
  font-size: 22rpx;
  color: var(--color-text-light);
}

/* Goal Card */
.goal-card {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.goal-card:active { transform: scale(0.98); }

.goal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.goal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  flex: 1;
}

.goal-status-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.goal-status-badge.pending { background: rgba(148,163,184,0.1); color: #94A3B8; }
.goal-status-badge.in_progress { background: rgba(59,130,246,0.1); color: #3B82F6; }
.goal-status-badge.completed { background: rgba(6,214,160,0.1); color: #06D6A0; }

.goal-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.goal-meta { display: flex; gap: 16rpx; }

/* Empty State */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-emoji { display: block; font-size: 80rpx; margin-bottom: 24rpx; }

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* Add Button */
.add-btn-wrap {
  padding: 24rpx 0;
}

.add-btn {
  width: 100%;
  background: linear-gradient(135deg, rgba(124,92,252,0.08), rgba(255,107,157,0.08));
  color: var(--color-primary);
  border: 2rpx dashed rgba(124, 92, 252, 0.25);
  border-radius: var(--radius-xl);
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.add-btn::after { border: none; }
.add-btn:active { background: linear-gradient(135deg, rgba(124,92,252,0.15), rgba(255,107,157,0.12)); }
