/* Onboarding - 沉浸式引导体验 */
.onboarding-page {
  min-height: 100vh;
  background: var(--gradient-mesh);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 120rpx 48rpx 80rpx;
  animation: float-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

/* ======================== */
/* 步骤 1: 欢迎页 - 大气沉浸 */
/* ======================== */
.welcome-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo-circle {
  width: 180rpx;
  height: 180rpx;
  border-radius: 52rpx;
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  position: relative;
  animation: bounce-in 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

/* logo 光晕 */
.logo-circle::before {
  content: '';
  position: absolute;
  inset: -16rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, rgba(124,92,252,0.2), rgba(255,107,157,0.15));
  z-index: -1;
  animation: pulse-soft 3s ease-in-out infinite;
}

.logo-text {
  color: #FFFFFF;
  font-size: 80rpx;
  font-weight: 800;
}

.app-name {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  background: var(--gradient-sunset);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.slogan {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 96rpx;
}

.slogan-line {
  font-size: 32rpx;
  color: var(--color-text-secondary);
  line-height: 2.2;
  letter-spacing: 2rpx;
}

.start-btn {
  width: 420rpx;
  font-size: 34rpx;
  padding: 30rpx 0;
}

/* ======================== */
/* 通用步骤内容 */
/* ======================== */
.step-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.step-question {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--spacing-lg);
  letter-spacing: -0.5rpx;
}

.mt-lg {
  margin-top: 52rpx;
}

.name-input,
.task-input {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  border-radius: var(--radius-xl);
  padding: 30rpx 36rpx;
  font-size: 32rpx;
}

/* 选项组 - 胶囊按钮 */
.option-group {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.option-item {
  padding: 20rpx 40rpx;
  border-radius: var(--radius-2xl);
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  color: var(--color-text-secondary);
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid rgba(124, 92, 252, 0.08);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.option-item:active {
  transform: scale(0.95);
}

.option-item.active {
  background: rgba(124, 92, 252, 0.12);
  color: var(--color-primary);
  border-color: rgba(124, 92, 252, 0.25);
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(124, 92, 252, 0.12);
}

.next-btn {
  margin-top: auto;
  width: 100%;
  font-size: 32rpx;
  padding: 28rpx 0;
}

.next-btn[disabled] {
  background: rgba(124, 92, 252, 0.12) !important;
  color: var(--color-text-light) !important;
  box-shadow: none !important;
}

/* ======================== */
/* 步骤 4: 思维转换 - 高光时刻 */
/* ======================== */
.mindset-experience {
  justify-content: center;
}

.mindset-card {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  border-radius: var(--radius-lg);
  padding: 48rpx 40rpx;
  margin-bottom: 48rpx;
  position: relative;
  overflow: hidden;
  animation: scale-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

/* 卡片装饰渐变 */
.mindset-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(124,92,252,0.08), rgba(255,107,157,0.06));
  pointer-events: none;
}

.mindset-task {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--spacing-lg);
  position: relative;
}

.mindset-transition {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  background: var(--gradient-sunset);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: var(--spacing-md);
}

.mindset-text {
  display: block;
  font-size: 30rpx;
  color: var(--color-text);
  line-height: 2;
  margin-bottom: var(--spacing-lg);
  position: relative;
}

.mindset-ending {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.mindset-actions {
  display: flex;
  gap: var(--spacing-md);
}

.mindset-actions button {
  flex: 1;
}

/* ======================== */
/* 步骤 5: 订阅授权 */
/* ======================== */
.subscribe-step {
  justify-content: center;
  align-items: center;
}

.subscribe-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: var(--spacing-xl);
  letter-spacing: -1rpx;
}

.subscribe-desc {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 72rpx;
}

.subscribe-desc text {
  font-size: 30rpx;
  color: var(--color-text-secondary);
  line-height: 2.2;
}

.subscribe-btn {
  width: 420rpx;
  font-size: 32rpx;
  padding: 28rpx 0;
  margin-bottom: var(--spacing-lg);
}

.skip-btn {
  background: transparent;
  color: var(--color-text-light);
  font-size: 28rpx;
  border: none;
}

.skip-btn::after {
  border: none;
}

/* ======================== */
/* 步骤 6: 完成 - 庆祝感 */
/* ======================== */
.complete-step {
  justify-content: center;
  align-items: center;
}

.complete-emoji {
  font-size: 120rpx;
  margin-bottom: var(--spacing-xl);
  animation: bounce-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.complete-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.8;
  text-align: center;
}

.complete-subtitle {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  background: var(--gradient-warm);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-top: var(--spacing-md);
  margin-bottom: 72rpx;
}

.go-btn {
  width: 420rpx;
  font-size: 34rpx;
  padding: 28rpx 0;
}

/* ======================== */
/* 步骤指示器 - 渐变胶囊 */
/* ======================== */
.step-indicator {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.indicator-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(124, 92, 252, 0.12);
  transition: all 0.3s ease;
}

.indicator-dot.active {
  background: var(--gradient-primary);
  width: 36rpx;
  border-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(124, 92, 252, 0.3);
}

/* ======================== */
/* 动画 */
/* ======================== */
@keyframes float-in {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes bounce-in {
  0% { transform: scale(0.3); opacity: 0; }
  50% { transform: scale(1.05); }
  70% { transform: scale(0.95); }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes scale-in {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes pulse-soft {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.08); opacity: 1; }
}
