/* 首页 - 年轻化重设计 */
.index-page {
  padding-bottom: 180rpx;
  padding-top: var(--spacing-md);
}

/* ======================== */
/* 顶部状态栏 */
/* ======================== */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.streak-badge {
  display: flex;
  align-items: center;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  padding: 10rpx 24rpx;
  border-radius: var(--radius-2xl);
}

.streak-fire {
  font-size: 28rpx;
}

.streak-num {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-secondary);
  margin: 0 4rpx 0 8rpx;
}

.streak-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.coin-badge {
  position: relative;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(251,191,36,0.15), rgba(255,107,157,0.10));
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid rgba(251,191,36,0.25);
  padding: 10rpx 28rpx;
  border-radius: var(--radius-2xl);
  overflow: hidden;
}

.coin-glow {
  position: absolute;
  top: -50%;
  right: -20%;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(251,191,36,0.3), transparent);
  animation: pulse-soft 3s ease-in-out infinite;
}

.coin-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.coin-amount {
  font-size: 28rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #D97706, #FBBF24);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ======================== */
/* AI 问候区 - 大字呼吸感 */
/* ======================== */
.hero-section {
  margin: var(--spacing-xl) 0 var(--spacing-2xl);
  padding-left: 8rpx;
}

.hero-greeting {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  background: var(--gradient-sunset);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1.3;
}

.hero-date {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-light);
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

/* ======================== */
/* 情绪签到 */
/* ======================== */
.mood-checkin {
  margin-bottom: var(--spacing-xl);
}

.mood-checkin-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-md);
  padding-left: 8rpx;
}

.mood-checkin-list {
  display: flex;
  justify-content: space-between;
  gap: var(--spacing-xs);
}

.mood-checkin-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  border-radius: var(--radius-lg);
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 2rpx solid rgba(124, 92, 252, 0.06);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.mood-checkin-item:active {
  transform: scale(0.9);
}

.mood-checkin-item.selected {
  background: rgba(124, 92, 252, 0.1);
  border-color: rgba(124, 92, 252, 0.25);
  box-shadow: 0 4rpx 20rpx rgba(124, 92, 252, 0.15);
  transform: scale(1.05);
}

.mood-checkin-emoji {
  font-size: 40rpx;
  margin-bottom: 6rpx;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.mood-checkin-item.selected .mood-checkin-emoji {
  transform: scale(1.2);
}

.mood-checkin-text {
  font-size: 20rpx;
  color: var(--color-text-light);
  font-weight: 500;
}

.mood-checkin-item.selected .mood-checkin-text {
  color: var(--color-primary);
  font-weight: 600;
}

/* 已签到状态 */
.mood-done {
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx;
  border-radius: var(--radius-2xl);
  background: linear-gradient(135deg, rgba(124,92,252,0.06), rgba(255,107,157,0.04));
  border: 1rpx solid rgba(124, 92, 252, 0.1);
  margin-bottom: var(--spacing-xl);
}

.mood-done-emoji {
  font-size: 36rpx;
  margin-right: var(--spacing-sm);
}

.mood-done-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-right: var(--spacing-sm);
}

.mood-done-hint {
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-left: auto;
}

/* ======================== */
/* 对话流 */
/* ======================== */
.chat-flow {
  margin-bottom: var(--spacing-lg);
}

/* ======================== */
/* 今日任务区 */
/* ======================== */
.today-section {
  margin-top: var(--spacing-lg);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding-left: 8rpx;
}

.section-emoji {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  flex: 1;
}

/* ======================== */
/* 已完成归档区 */
/* ======================== */
.done-section {
  margin-top: var(--spacing-xl);
  opacity: 0.7;
}

.done-title {
  color: var(--color-text-muted);
}

.tag-green {
  background: rgba(6, 214, 160, 0.15);
  color: #06D6A0;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-xl);
  font-weight: 600;
}

.done-list {
  animation: float-in 0.3s ease-out;
}

/* ======================== */
/* 快捷操作 - 胶囊按钮 */
/* ======================== */
.actions-flow {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin: var(--spacing-xl) 0;
  padding: 0 8rpx;
}

.action-pill {
  flex: none;
  padding: 18rpx 36rpx;
  border-radius: var(--radius-2xl);
  font-size: 26rpx;
  font-weight: 500;
  border: none;
  line-height: 1.4;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.action-pill::after {
  border: none;
}

.action-pill:active {
  transform: scale(0.93);
}

.action-pill.primary {
  background: var(--gradient-primary);
  color: var(--color-text-white);
  box-shadow: 0 6rpx 20rpx rgba(124, 92, 252, 0.3);
}

.action-pill.secondary {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  color: var(--color-primary);
  border: 2rpx solid rgba(124, 92, 252, 0.15);
}

.action-pill.muted {
  background: transparent;
  color: var(--color-text-light);
}

/* ======================== */
/* 底部输入 - 毛玻璃浮动 */
/* ======================== */
.input-float {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-md) var(--spacing-lg);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(245, 243, 255, 0.98), rgba(245, 243, 255, 0));
}

.input-glass {
  display: flex;
  align-items: center;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  border-radius: var(--radius-2xl);
  padding: 8rpx 8rpx 8rpx 32rpx;
  box-shadow: var(--shadow-md);
}

.msg-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  height: 72rpx;
}

.input-placeholder {
  color: var(--color-text-light);
  font-size: 26rpx;
}

.send-circle {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(124, 92, 252, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.send-circle.active {
  background: var(--gradient-primary);
  box-shadow: 0 4rpx 16rpx rgba(124, 92, 252, 0.35);
}

.send-arrow {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-light);
}

.send-circle.active .send-arrow {
  color: var(--color-text-white);
}
