/* 首页 - V2 任务优先 */
.index-page {
  padding-bottom: 180rpx;
  padding-top: var(--spacing-md);
}

/* Active Goals */
.active-goals {
  margin-bottom: 16rpx;
}

.goal-progress-card {
  background: linear-gradient(135deg, rgba(59,130,246,0.06), rgba(124,92,252,0.06));
  border: 1rpx solid rgba(59,130,246,0.12);
  border-radius: var(--radius-lg);
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}

.goal-progress-card:active { transform: scale(0.98); }

.goal-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.goal-progress-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}

.goal-progress-pct {
  font-size: 24rpx;
  font-weight: 700;
  color: #3B82F6;
}

.goal-progress-track {
  height: 10rpx;
  background: rgba(59,130,246,0.08);
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.goal-progress-fill {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #3B82F6, #7C5CFC);
  transition: width 0.5s ease;
  min-width: 2%;
}

.goal-today-task {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* ======================== */
/* 顶部状态栏 */
/* ======================== */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.streak-badge {
  display: flex;
  align-items: center;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  padding: 10rpx 24rpx;
  border-radius: var(--radius-2xl);
}

.streak-fire { font-size: 28rpx; }

.streak-num {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-secondary);
  margin: 0 4rpx 0 8rpx;
}

.streak-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.coin-badge {
  position: relative;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(251,191,36,0.15), rgba(255,107,157,0.10));
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid rgba(251,191,36,0.25);
  padding: 10rpx 28rpx;
  border-radius: var(--radius-2xl);
  overflow: hidden;
}

.coin-glow {
  position: absolute;
  top: -50%;
  right: -20%;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(251,191,36,0.3), transparent);
  animation: pulse-soft 3s ease-in-out infinite;
}

.coin-icon { font-size: 26rpx; margin-right: 8rpx; }

.coin-amount {
  font-size: 28rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #D97706, #FBBF24);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ======================== */
/* 问候区 */
/* ======================== */
.hero-section {
  margin: var(--spacing-lg) 0 var(--spacing-lg);
  padding-left: 8rpx;
}

.hero-greeting {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  background: var(--gradient-sunset);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1.3;
}

.hero-date {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-light);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

/* ======================== */
/* 情绪签到 - 横向滚动一行 */
/* ======================== */
.mood-scroll {
  white-space: nowrap;
  margin-bottom: var(--spacing-md);
}

.mood-scroll-inner {
  display: inline-flex;
  gap: var(--spacing-sm);
  padding: 4rpx 0;
}

.mood-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-2xl);
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid rgba(124, 92, 252, 0.08);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.mood-chip:active {
  transform: scale(0.93);
}

.mood-chip-emoji { font-size: 32rpx; margin-right: 8rpx; }

.mood-chip-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

/* 已签到 - 紧凑一行 */
.mood-done-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-2xl);
  background: linear-gradient(135deg, rgba(124,92,252,0.06), rgba(255,107,157,0.04));
  border: 1rpx solid rgba(124, 92, 252, 0.1);
  margin-bottom: var(--spacing-md);
}

.mood-done-emoji { font-size: 32rpx; margin-right: 12rpx; }

.mood-done-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* ======================== */
/* 今日容量 */
/* ======================== */
.capacity-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-md);
}

.capacity-label {
  font-size: 22rpx;
  color: var(--color-text-light);
  flex-shrink: 0;
}

.capacity-value {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
  flex-shrink: 0;
}

.capacity-value.overloaded {
  color: #FF6B6B;
}

.capacity-track {
  flex: 1;
  height: 10rpx;
  background: rgba(124, 92, 252, 0.06);
  border-radius: 5rpx;
  overflow: hidden;
}

.capacity-fill {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #7C5CFC, #A78BFA);
  transition: width 0.5s ease;
}

.capacity-fill.overloaded {
  background: linear-gradient(90deg, #FF6B6B, #FF6B9D);
}

/* ======================== */
/* 项目筛选 */
/* ======================== */
.filter-scroll {
  white-space: nowrap;
  margin-bottom: var(--spacing-lg);
}

.filter-inner {
  display: inline-flex;
  gap: var(--spacing-sm);
  padding: 4rpx 0;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-2xl);
  font-size: 22rpx;
  font-weight: 600;
  background: var(--glass-bg);
  border: 1rpx solid rgba(124, 92, 252, 0.08);
  transition: all 0.25s ease;
}

.filter-chip.active {
  box-shadow: 0 4rpx 16rpx rgba(124, 92, 252, 0.2);
}

.filter-count {
  font-size: 20rpx;
  opacity: 0.7;
}

/* ======================== */
/* 任务区域 */
/* ======================== */
.today-section {
  min-height: 200rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-2xl) 0;
}

.empty-emoji { font-size: 64rpx; margin-bottom: var(--spacing-md); }

.empty-text {
  font-size: 26rpx;
  color: var(--color-text-light);
}

/* ======================== */
/* 已完成归档区 */
/* ======================== */
.done-section {
  margin-top: var(--spacing-xl);
  opacity: 0.7;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding-left: 8rpx;
}

.section-emoji { font-size: 32rpx; margin-right: 12rpx; }

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  flex: 1;
}

.done-title { color: var(--color-text-light); }

.tag-green {
  background: rgba(6, 214, 160, 0.15);
  color: #06D6A0;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-xl);
  font-weight: 600;
}

.toggle-arrow {
  font-size: 24rpx;
  color: var(--color-text-light);
  margin-left: 12rpx;
  transition: transform 0.3s ease;
  display: inline-block;
}

.toggle-arrow.open {
  transform: rotate(90deg);
}

.done-list {
  animation: float-in 0.3s ease-out;
}

/* ======================== */
/* 预览蒙层 & 面板 */
/* ======================== */
.preview-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 100;
}

.preview-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #F5F3FF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.preview-panel.show {
  transform: translateY(0);
}

.preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.preview-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.preview-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-text-light);
  border-radius: 50%;
  background: var(--glass-bg);
}

.preview-scroll {
  flex: 1;
  max-height: 50vh;
}

.preview-card {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.preview-card-main { flex: 1; }

.preview-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
}

.preview-card-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.preview-tag {
  font-size: 20rpx;
  color: var(--color-text-light);
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(124, 92, 252, 0.06);
}

.preview-remove {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-text-light);
  flex-shrink: 0;
  margin-left: 12rpx;
}

.preview-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-confirm {
  flex: 1;
  background: linear-gradient(135deg, #7C5CFC, #A78BFA);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  border-radius: var(--radius-2xl);
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(124, 92, 252, 0.25);
}

.btn-confirm::after { border: none; }

.btn-cancel {
  flex: none;
  background: transparent;
  color: var(--color-text-light);
  font-size: 26rpx;
  padding: 20rpx 32rpx;
  border: none;
}

.btn-cancel::after { border: none; }

/* ======================== */
/* 底部输入 - 任务创建入口 */
/* ======================== */
.input-float {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-md) var(--spacing-lg);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(245, 243, 255, 0.98), rgba(245, 243, 255, 0));
}

.input-glass {
  display: flex;
  align-items: center;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: var(--glass-border);
  border-radius: var(--radius-2xl);
  padding: 8rpx 8rpx 8rpx 32rpx;
  box-shadow: var(--shadow-md);
}

.msg-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  height: 72rpx;
}

.input-placeholder {
  color: var(--color-text-light);
  font-size: 24rpx;
}

.send-circle {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(124, 92, 252, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.send-circle.active {
  background: var(--gradient-primary);
  box-shadow: 0 4rpx 16rpx rgba(124, 92, 252, 0.35);
}

.send-arrow {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-light);
}

.send-circle.active .send-arrow {
  color: var(--color-text-white);
}
