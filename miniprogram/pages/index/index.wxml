<!-- 首页 - V2 任务优先 + 自然语言创建 -->
<view class="container index-page">

  <!-- 顶部状态栏 -->
  <view class="top-bar anim-float-in">
    <view class="streak-badge">
      <text class="streak-fire">🔥</text>
      <text class="streak-num">{{streakDays}}</text>
      <text class="streak-text">天</text>
    </view>
    <view class="coin-badge" bindtap="goToProfile">
      <view class="coin-glow"></view>
      <text class="coin-icon">✨</text>
      <text class="coin-amount">{{coins}}</text>
    </view>
  </view>

  <!-- 问候区 -->
  <view class="hero-section anim-float-in anim-delay-1">
    <text class="hero-greeting">{{greeting}}</text>
    <text class="hero-date">{{weekday}} · {{dateStr}}</text>
  </view>

  <!-- 情绪签到 - 横向滚动一行 -->
  <scroll-view class="mood-scroll anim-float-in anim-delay-2" scroll-x wx:if="{{!moodCheckedIn}}">
    <view class="mood-scroll-inner">
      <view
        class="mood-chip"
        wx:for="{{moodList}}"
        wx:key="value"
        bindtap="onMoodTap"
        data-value="{{item.value}}"
        data-emoji="{{item.emoji}}"
        data-label="{{item.label}}"
      >
        <text class="mood-chip-emoji">{{item.emoji}}</text>
        <text class="mood-chip-text">{{item.label}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 已签到 - 一行展示 -->
  <view class="mood-done-bar anim-scale-in" wx:if="{{moodCheckedIn}}">
    <text class="mood-done-emoji">{{selectedMoodEmoji}}</text>
    <text class="mood-done-text">{{selectedMoodLabel}}</text>
  </view>

  <!-- 今日容量 -->
  <view class="capacity-bar anim-float-in anim-delay-2">
    <text class="capacity-label">今日已安排</text>
    <text class="capacity-value {{capacityOverloaded ? 'overloaded' : ''}}">{{capacityText}}</text>
    <view class="capacity-track">
      <view class="capacity-fill {{capacityOverloaded ? 'overloaded' : ''}}" style="width: {{capacityPercent}}%"></view>
    </view>
  </view>

  <!-- 项目筛选标签 -->
  <scroll-view class="filter-scroll" scroll-x>
    <view class="filter-inner">
      <view
        class="filter-chip {{activeFilter === item.key ? 'active' : ''}}"
        wx:for="{{projectFilters}}"
        wx:key="key"
        bindtap="onFilterTap"
        data-key="{{item.key}}"
        style="{{activeFilter === item.key ? 'background:' + item.color + '; color: #fff;' : 'color:' + item.color + ';'}}"
      >
        <text>{{item.icon}} {{item.label}}</text>
        <text class="filter-count">{{item.count}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 今日任务列表 -->
  <view class="today-section" wx:if="{{filteredTasks.length > 0}}">
    <task-card
      wx:for="{{filteredTasks}}"
      wx:key="id"
      task="{{item}}"
      bind:complete="onTaskComplete"
      bind:skip="onTaskSkip"
      bind:subtaskToggle="onSubtaskToggle"
    />
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{filteredTasks.length === 0 && todayTasks.length > 0}}">
    <text class="empty-text">该分类下没有任务</text>
  </view>
  <view class="empty-state" wx:if="{{todayTasks.length === 0}}">
    <text class="empty-emoji">🌟</text>
    <text class="empty-text">输入任务开始今天的计划</text>
  </view>

  <!-- 已完成归档 -->
  <view class="done-section" wx:if="{{completedTasks.length > 0}}">
    <view class="section-header" bindtap="toggleDoneList">
      <text class="section-emoji">✅</text>
      <text class="section-title done-title">已完成</text>
      <view class="tag tag-green">{{completedTasks.length}}项</view>
      <text class="toggle-arrow {{showDoneList ? 'open' : ''}}">▸</text>
    </view>
    <view class="done-list" wx:if="{{showDoneList}}">
      <task-card
        wx:for="{{completedTasks}}"
        wx:key="id"
        task="{{item}}"
        completed="{{true}}"
      />
    </view>
  </view>

  <!-- 预览蒙层 -->
  <view class="preview-mask" wx:if="{{showPreview}}" catchtap="onCancelPreview"></view>

  <!-- 任务解析预览面板 -->
  <view class="preview-panel {{showPreview ? 'show' : ''}}">
    <view class="preview-header">
      <text class="preview-title">识别到 {{previewTasks.length}} 个任务</text>
      <view class="preview-close" catchtap="onCancelPreview">✕</view>
    </view>
    <scroll-view class="preview-scroll" scroll-y>
      <view
        class="preview-card"
        wx:for="{{previewTasks}}"
        wx:key="id"
      >
        <view class="preview-card-main">
          <text class="preview-card-title">{{item.title}}</text>
          <view class="preview-card-tags">
            <text class="preview-tag" wx:if="{{item.estimatedMinutes}}">⏱ {{item.estimatedMinutes}}min</text>
            <text class="preview-tag" wx:if="{{item.project}}">{{item.project}}</text>
            <text class="preview-tag" wx:if="{{item.deadline}}">📅 {{item.deadline}}</text>
          </view>
        </view>
        <view class="preview-remove" catchtap="onRemovePreviewTask" data-index="{{index}}">✕</view>
      </view>
    </scroll-view>
    <view class="preview-actions">
      <button class="btn-confirm" catchtap="onConfirmPreview">确认添加</button>
      <button class="btn-cancel" catchtap="onCancelPreview">取消</button>
    </view>
  </view>

  <!-- 底部输入区 - 任务创建入口 -->
  <view class="input-float">
    <view class="input-glass">
      <input
        class="msg-input"
        placeholder="输入任务，如「明天交报告，学Python 1小时」"
        placeholder-class="input-placeholder"
        value="{{inputValue}}"
        bindinput="onInput"
        bindconfirm="onSendMessage"
        confirm-type="send"
      />
      <view class="send-circle {{inputValue ? 'active' : ''}}" bindtap="onSendMessage">
        <text class="send-arrow">+</text>
      </view>
    </view>
  </view>

</view>
